try:
    n = int(input("Введите общее количество чисел n: "))
    
    count = 0        
    current_step = 0 
    
    try:
        number = float(input("Введите 1-е число: "))
        
        while number > 0 and current_step < n:
            count += 1
            current_step += 1
            
            if current_step < n:
                number = float(input(f"Введите {current_step + 1}-е число: "))

        print(f"Количество положительных чисел в начале последовательности: {count}")

    except ValueError:
        print("Ошибка! Вы ввели буквы или недопустимые значения при вводе чисел последовательности.")
        print("Рекомендации: пожалуйста, вводите только действительные числа (через точку).")

except ValueError:
    print("Ошибка! Вы ввели буквы или недопустимые значения для количества чисел n.")
    print("Рекомендации: пожалуйста, вводите только целые числа.")